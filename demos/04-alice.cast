[37.61476, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3ma v3.1 with per-customer splitting?\r\u001b[2C\u001b[14B\u001b[23m\u001b[38;5;216mTransfiguring\u001b[39m\u001b[22;1H\u001b[20;3H\u001b[?25h"]
