[39mMonitor\u001b[11Gevent:\u001b[18G\"wake\u001b[24Gon\u001b[27Gnew\u001b[31Gagent-talk\u001b[42Gmessages\u001b[51Gfrom\u001b[56Gbob\u001b[60Gin\u001b[63Galice\u001b[69Ginbox\r\u001b[1Bspool\"\u001b[K\r\u001b[2B \u001b[3G\u001b[38;5;246mRead \u001b[1m1\u001b[22m file, listed \u001b[1m1\u001b[22m directory, ran \u001b[1m2\u001b[22m shell commands \r\u001b[2B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39m\u001b[1m\ud83d\udcac bob\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[4C\u001b[1B\u001b[1m\u001b[3m\ud83d\udce5 bob\u001b[23m\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mQuick one: for customer-churn-v3, are train/test splits grouped by \r\u001b[4C\u001b[1Bcustomer_id, or just split row-wise?\r\u001b[2C\u001b[1B\u001b[23m\u001b[K\r\u001b[4C\u001b[1B\u001b[1m\u001b[3m\ud83d\udce4 you\r\u001b[2C\u001b[1B\u001b[22m\u001b[23m\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mRow-wise, not grouped \u2014 same customer_id can show up in both train and \r\u001b[1B\u001b[23m \u001b[3G\u001b[2m\u258e\u001b[22m \u001b[3mtest.\u001b[23m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m\u273b\u001b[3GChurned for\u001b[15G33s \u00b7 1\u001b[23Gm\u001b[25Gnitor still running\r\u001b[3B\u001b[39m\u276f\u00a0\u001b[2mcheck the spool for bob's reply\r\u001b[32C\u001b[2B\u001b[22m\u001b[38;5;246m\u2190 for agents \u00b7 \u2193\u001b[50Gto manage\u001b[39m\u001b[K\u001b[22;1H\u001b[20;3H\u001b[?25h\u001b(B\u000f\u001b[<u\u001b[>1u\u001b[>4;2m\u001b[?1000h\u001b[?1002h\u001b[?1003h\u001b[?1006h\u001b[?25l\u001b[2J\u001b[H\u001b[2;1H\u001b[38;5;231m\u25cf\u001b[3G\u001b[39m\u001b[1m\ud83d\udcac bob\u001b[22m\u001b[3;3H\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[1m\u001b[3m\ud83d\udce4 you\u001b[22m\u001b[23m\u001b[4;3H\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mcustomer-churn-v3 is ready in ./datasets if you want to start\u001b[23m\u001b[5;3H\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mtraining.\u001b[23m\r\u001b[2B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39m\u