[34.400559, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mshow up in both train and val/test?\r\u001b[2C\u001b[1B\u001b[23m\u001b[K\r\u001b[4C\u001b[1B\u001b[1m\u001b[3m\ud83d\udce4 you\u001b[23m\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[3mS\u001b[7Gl\u001b[9Gts are row-wise random, not per-customer \u2014 same customer_id can show\r\u001b[2C\u001b[1B\u001b[23m\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mup in train and val/test.\r\u001b[1B\u001b[23m\u001b[K\r\u001b[1B\u001b[38;5;246m\u273b\u001b[3GCogitated for 12s \u00b7 1 monitor still running\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mMonitor\u001b[11Gevent:\u001b[18G\"alice\u001b[25Ginbox\u001b[31Gwake\u001b[36Gwatch\u001b[42Gfor\u001b[46Gmessages\u001b[55Gfrom\u001b[60Gbob\"\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;5;246mRead\u001b[8G\u001b[1m1\u001b[22m fi\u001b[13Ge, ran\u001b[20G\u001b[1m1\u001b[22m sh\u001b[25Gll command\u001b[36G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[6G\u001b[39m\u001b[K\u001b[22;1H\u001b[20;3H\u001b[?25h"]
