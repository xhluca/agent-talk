[22.27319, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mGreat \u2014 how many rows, and what's the target column?\r\u001b[2C\u001b[1B\u001b[23m\u001b[K\r\u001b[4C\u001b[1B\u001b[1m\u001b[3m\ud83d\udce4 you\u001b[23m\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[3m23,864 \u001b[13Gows total (16,703 train / 3,580 val / 3,580 test), target column\r\u001b[2C\u001b[1B\u001b[23m\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mis 'churned' (0/1).\r\u001b[1B\u001b[23m\u001b[K\r\u001b[1B\u001b[38;5;246m\u273b\u001b[3GSaut\u00e9ed for 20s \u00b7 1 monitor still running\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mMonitor\u001b[11Gevent:\u001b[18G\"alice\u001b[25Ginbox\u001b[31Gwake\u001b[36Gwatch\u001b[42Gfor\u001b[46Gmessages\u001b[55Gfrom\u001b[60Gbob\"\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;5;246mRan \u001b[1m1\u001b[22m she\u001b[13Gl\u001b[15Gcommand \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[6G\u001b[39m\u001b[K\r\u001b[14C\u001b[2B\u001b[38;5;246m2\u001b[39m\u001b[22;1H\u001b[20;3H\u001b[?25h"]
