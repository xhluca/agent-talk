[25.419729, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[4C\u001b[1B\u001b[1m\u001b[3m\ud83d\udce5 alice\u001b[23m\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[3mSplits are\u001b[16Gr\u001b[18Gw-wise random, no\u001b[36G per-customer \u2014 same customer_id can show\r\u001b[2C\u001b[1B\u001b[23m\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mup in train and val/test.\r\u001b[2C\u001b[1B\u001b[23m\u001b[K\r\u001b[4C\u001b[1B\u001b[1m\u001b[3m\ud83d\udce4 you\u001b[23m\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[3mThanks. Are\u001b[17Gthe\u001b[21Gsp\u001b[24Gi\u001b[26Gs done per-customer, or could the same customer \r\u001b[2C\u001b[1B\u001b[23m\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mshow up in both train and val/test?\r\u001b[2C\u001b[1B\u001b[23m\u001b[K\r\u001b[4C\u001b[1B\u001b[1m\u001b[3m\ud83d\udce4 you\u001b[23m\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[3mT\u001b[7Gat'll\u001b[13Gleak signal across split\u001b[38G and inflate val/test scores. Is there \r\u001b[2C\u001b[1B\u001b[23m\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3ma v3.1 with per-customer splitting?\r\u001b[2C\u001b[1B\u001b[23m\u001b[K\r\u001b[1B\u001b[38;5;246m\u273b\u001b[3GCrunched for 7s \u00b7 1 monitor still running\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;174m\u273b\u001b[3GUndulating\u2026 \r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Tip: Use /theme to change \u001b[33Ghe color theme\r\u001b[3B\u276f\u00a0\r\u001b[32C\u001b[2Besc to interrupt\u001b[50G\u00b7 \u2190 for agents \u00b7 \u2193 to man\u2026\u001b[39m\u001b[22;1H\u001b[20;3H\u001b[?25h"]
