[26.422835, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[1m\u001b[3m\ud83d\udce4 you\r\u001b[4C\u001b[1B\u001b[22mGreat \u2014 how many rows, and what's the target column?\r\u001b[2C\u001b[1B\u001b[23m\u001b[K\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[1m\u001b[3m\ud83d\udce5 alice\r\u001b[4C\u001b[1B\u001b[22m23,864 rows total (16,703 train / 3,580 val / 3,580 test), target column\r\u001b[4C\u001b[1Bis 'churned' (0/1).\u001b[23m\u001b[K\r\u001b[4C\u001b[2B\u001b[1m\u001b[3m\ud83d\udce4\u001b[8Gyou\u001b[23m\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[3mThanks. Are\u001b[18Ghe splits done per-customer, or could th\u001b[59G same customer \u001b[23m\u001b[K\r\u001b[4C\u001b[1B\u001b[3mshow up in both train and val/test?\r\u001b[4C\u001b[2B\u001b[1m\ud83d\udce5\u001b[8Galice\r\u001b[4C\u001b[1B\u001b[22mSplit\u001b[11G are row-wise ran\u001b[30Gm,\u001b[33Gnot per-custome\u001b[50G\u2014 same custo\u001b[64Gr_id can show\r\u001b[4C\u001b[1Bup in train and\u001b[21Gval/test.\u001b[23m\u001b[K\r\u001b[4C\u001b[2B\u001b[1m\u001b[3m\ud83d\udce4\u001b[8Gyou\u001b[23m\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[3mThank\u001b[11G. Are the splits \u001b[30Gne\u001b[33Gper-customer\u001b[23m\u001b[K\u001b[22;1H\u001b[20;3H\u001b[?25h"]
[26.6875, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[3mThanks. Are the splits done per-customer, or could the same customer \r\u001b[4C\u001b[1Bshow up\u001b[13Gin both t\u001b[23Gain and val/\u001b[36Ge\u001b[38Gt?\u001b[23m\u001b[K\r\u001b[4C\u001b[3B\u001b[3mSplits\u001b[12Gare row-wise random, not\u001b[37Gper-customer \u2014 same\u001b[57Gcu\u001b[61Gomer_id can show\r\u001b[4C\u001b[1Bup\u001b[8Gin t\u001b[13Gain and val/test.\r\u001b[4C\u001b[6B\u001b[1m\ud83d\udce4\u001b[8Gyou\u001b[23m\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[3mThat'll l\u001b[15Gak signal\u001b[25Gacross splits and inflate val/test scores. Is there \r\u001b[4C\u001b[1Ba v3.1 with\u001b[17Gper-customer splitting?\r\u001b[2B\u001b[23m\u001b[38;5;174m\u00b7\u001b[3GHarmonizing\u2026 \u001b[38;5;246m(7s \u00b7 \u2193\u001b[24G374 tokens)\r\u001b[1B  \u23bf \u00a0Tip: Use /theme to change the color theme\u001b[39m\u001b[22;1H\u001b[20;3H\u001b[?25h"]
