[29.630322, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mMonitor event: \"wake on incoming agent-talk\u001b[47Gmessages\u001b[56Gfrom\u001b[61Galice\"\r\u001b[2B \u001b[3G\u001b[38;5;246mRan \u001b[1m1\u001b[22m shell command\u001b[23G\u001b[39m\u001b[K\r\u001b[2C\u001b[2B\u001b[1m\ud83d\udcac alice\u001b[22m\u001b[K\r\u001b[2C\u001b[2B\u001b[2m\u258e\u001b[22m \u001b[1m\u001b[3m\ud83d\udce5 alice\u001b[23m\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mcustomer-churn-v3 is ready in ./datasets if you want to start training.\r\u001b[1B\u001b[23m\u001b[K\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[1m\u001b[3m\ud83d\udce4 you\r\u001b[4C\u001b[1B\u001b[22mGreat \u2014 how many rows, and what's the target column?\r\u001b[2C\u001b[1B\u001b[23m\u001b[K\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[1m\u001b[3m\ud83d\udce5 alice\r\u001b[4C\u001b[1B\u001b[22m23,864 rows total (16,703 train / 3,580 val / 3,580 test), target column\r\u001b[4C\u001b[1Bis 'churned'\u001b[23m\u001b[K\u001b[22;1H\u001b[20;3H\u001b[?25h"]
[29.864857, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[1m\u001b[3m\ud83d\udce5 alice\r\u001b[1B\u001b[23m\u001b[22m \u001b[3G\u001b[2m\u258e\u001b[22m \u001b[3mcustomer-churn-v3 is ready in ./datasets if you want to start training.\r\u001b[2C\u001b[2B\u001b[23m\u001b[2m\u258e\u001b[22m \u001b[1m\u001b[3m\ud83d\udce4 you\u001b[23m\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mGreat \u2014 how many rows, and what's the target column?\r\u001b[1B\u001b[23m\u001b[K\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[1m\u001b[3m\ud83d\udce5 alice\r\u001b[4C\u001b[1B\u001b[22m23,864 rows total (16,703 train / 3,580 val / 3,580 test), target column\r\u001b[4C\u001b[1Bis 'chu\u001b[13Gned' (0/1).\u001b[23m\u001b[K\r\u001b[4C\u001b[3B\u001b[3mThanks.\u001b[13GAre\u001b[17Gthe splits\u001b[28Gdone per-customer, or\u001b[52Guld the same customer \r\u001b[2C\u001b[1B\u001b[23m\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mshow up in both train and val/test?\r\u001b[2C\u001b[1B\u001b[23m\u001b[K\r\u001b[4C\u001b[1B\u001b[1m\u001b[3m\ud83d\udce5 alice\u001b[23m\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[3mSplits ar\u001b[15G row-\u001b[23m\u001b[22;1H\u001b[20;3H\u001b[?25h"]
