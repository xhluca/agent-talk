[32.520197, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3ma v3.1 with per-customer splitting?\r\u001b[15B\u001b[23m\u001b[38;5;174m\u273d\u001b[7G\u001b[38;5;216mp\u001b[10G\u001b[38;5;174mi\u001b[16G\u001b[38;5;246m1\u001b[39m\u001b[22;1H\u001b[20;3H\u001b[?25h"]
[32.663873, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[15B\u001b[38;5;216mm\u001b[9G\u001b[38;5;174mr\u001b[39m\u001b[22;1H\u001b[20;3H\u001b[?25h"]
[32.813432, "o", "\u001b[?25l\u001b[H\r\u001b[15B\u001b[38;5;174m\u273b\u001b[5G\u001b[38;5;216ma\u001b[8G\u001b[38;5;174me\u001b[39m\u001b[22;1H\u001b[20;3H\u001b[?25h"]
[32.888047, "o", "\u001b[?25l\u001b[H\r\u001b[15B\u001b[38;5;174m\u2736\u001b[4G\u001b[38;5;216mc\u001b[7G\u001b[38;5;174mp\u001b[39m\u001b[22;1H\u001b[20;3H\u001b[?25h"]
[32.973869, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[13BConversation\u001b[16Gwrapped\u001b[24Gnaturally\u001b[34G\u2014\u001b[36Gno\u001b[39Greply\u001b[45Gneeded.\r\u001b[2B\u001b[38;5;174m*\u001b[23G\u001b[38;5;246m3\u001b[39m\u001b[22;1H\u001b[20;3H\u001b[?25h"]
[32.990365, "o", "\u001b[?25l\u001b[H\r\u001b[3C\u001b[15B\u001b[38;5;174mcam\u001b[39m\u001b[22;1H\u001b[20;3H\u001b[?25h"]
