[29.053712, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[12B\u001b[1m\ud83d\udcac alice\r\u001b[2B\u001b[22m \u001b[3G\u001b[2m\u258e\u001b[22m \u001b[1m\u001b[3m\ud83d\udce5 alice\u001b[23m\u001b[22m\u001b[K\r\u001b[1B  \u001b[2m\u258e\u001b[22m \u001b[3mRow-wise, not grouped \u2014 same customer_id can show up in both train and \r\u001b[2C\u001b[1B\u001b[23m\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mtest.\u001b[23m\u001b[K\u001b[22;1H\u001b[20;3H\u001b[?25h"]
